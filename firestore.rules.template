// The B-Lab Cohort: Firestore security rules.
// TEMPLATE ONLY (no student data): pasting this into Firebase refuses EVERY student. Do not paste it.
// Run  python scripts/student_allowlist.py  on your own computer: it writes private/firestore.rules,
// which is this file with the student keys filled in. Paste THAT file into
// Firebase console > Firestore Database > Rules, then Publish.
// Registration is accepted only for signed-in @learner.manipal.edu users whose roll number + date of birth key
// is on the student list, and each key can be registered once. The rules are visible only to the
// Firebase project's owners; the website never sees the list.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTapmi() {
      return signedIn() && request.auth.token.email.lower().matches('.*@learner[.]manipal[.]edu$');
    }
    // One-way keys, SHA-256("blab-v1|ROLL|YYYY-MM-DD"), one per student on the TAPMI list.
    function isStudentKey(k) {
      return k in [/*STUDENT_KEYS*/];
    }

    // Records which account used which student key (one account per student).
    match /Claims/{key} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if isTapmi()
                    && isStudentKey(key)
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /ExpertUsers/{userId} {
      allow read: if isTapmi() && request.auth.uid == userId;
      allow create: if isTapmi() && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['email', 'timestamp', 'role', 'student_key'])
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == 'expert'
                    && request.resource.data.timestamp == request.time
                    && getAfter(/databases/$(database)/documents/Claims/$(request.resource.data.student_key)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
