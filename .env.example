# Copy to .env (gitignored) and fill in what you have. Every key is optional: ALADIN falls back gracefully without it.
# For GitHub Actions put the same names under Settings > Secrets and variables > Actions instead.
# Never commit real values.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=
GEMINI_MODEL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
HF_TOKEN=
ALADIN_GIT_PUSH=
ALADIN_WS_PORT=

# --- NEXUS ---
LLM_PROVIDER=
# ^ groq, gemini or auto (default auto): which free model reads the filings for the supply-chain graph
GEOCODE_CONTACT=
# ^ an email address put in the geocoder's User-Agent (OpenStreetMap asks for one); without it a generic description is used
OPENSKY_CLIENT_ID=
# ^ optional OpenSky login for a bigger flight quota; without it: anonymous, smaller quota
OPENSKY_CLIENT_SECRET=
# ^ optional, pairs with OPENSKY_CLIENT_ID
AISSTREAM_API_KEY=
# ^ free AISstream key for ship positions; without it the vessel layer stays off
