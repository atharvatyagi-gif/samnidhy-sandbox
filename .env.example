# Copy to .env (gitignored) and fill in what you have. Every key is optional: ALADIN falls back gracefully without it.
# For GitHub Actions put the same names under Settings > Secrets and variables > Actions instead.
# Never commit real values.
# --- live ticks: an Angel One account (needs a demat account). Without it the free NSE web feed is used. ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
ALADIN_SOURCE=
# ^ auto (default), angel or nse-web
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY_1=
GEMINI_API_KEY_1=
GROQ_MODEL=
GEMINI_MODEL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
HF_TOKEN=
ALADIN_GIT_PUSH=
ALADIN_WS_PORT=

# --- ALADIN 2.0 (scripts/aladin2) ---
FRED_API_KEY=
# ^ free key from fred.stlouisfed.org: adds the US 10-year yield as a market input; without it that input says "not measured"
# ALADIN_GIT_PUSH=1 lets the nightly job commit its ledger, states and journal with [skip ci]. python -m scripts.aladin2.sources_status shows which inputs are live.

# --- NEXUS ---
LLM_PROVIDER=
# ^ groq, gemini or auto (default auto): which free model reads the filings for the supply-chain graph
GEOCODE_CONTACT=
# ^ an email address put in the geocoder's User-Agent (OpenStreetMap asks for one); without it a generic description is used
OPENSKY_CLIENT_ID=
# ^ optional OpenSky login for a bigger flight quota; without it: anonymous, smaller quota
OPENSKY_CLIENT_SECRET=
# ^ optional, pairs with OPENSKY_CLIENT_ID
AISSTREAM_API_KEY=
# ^ free AISstream key for ship positions; without it the vessel layer stays off
AISHUB_USERNAME=
# ^ only if you are an AISHub member (they ask members to share an AIS feed; one request a minute)
VESSELAPI_KEY=
# ^ only if you hold a VesselAPI plan (that source stays off until its terms are verified)
TELEMETRY_INTERVAL_S=
# ^ asked refresh of the flight and vessel feed in seconds (default 30); the credit budgeter can make it slower
