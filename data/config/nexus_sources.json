{
  "version": 1,
  "prompt_version": "v1",
  "endpoints": {
    "annual_reports": {"path": "/api/annual-reports", "params": {"index": "equities"}, "referer": "/companies-listing/corporate-filings-annual-reports"},
    "announcements": {"path": "/api/corporate-announcements", "params": {"index": "equities"}, "referer": "/companies-listing/corporate-filings-announcements"}
  },
  "transcript_pattern": "transcript|earnings call|analyst.{0,12}(meet|call)|investor.{0,12}call|con(ference)? call",
  "transcripts_per_company": 2,
  "transcript_candidates": 5,
  "min_transcript_chars": 6000,
  "transcript_lookback_days": 400,
  "keywords": [
    "segment", "ind as 108", "customer", "customers", "10%", "ten percent", "major customer", "supplier", "suppliers", "procure", "procurement",
    "sole source", "single source", "raw material", "capacity", "utilisation", "utilization", "plant", "manufacturing facility",
    "related party", "value chain", "brsr", "purchases from", "dependence on", "dependent on"
  ],
  "min_keyword_hits": 2,
  "max_pages_per_filing": 24,
  "max_chunk_chars": 18000,
  "max_chunks_per_filing": 4,
  "system_prompt": "You extract supply-chain and revenue-dependency facts from company filings. Extract ONLY what the text states. Never use outside knowledge. Use null for anything not stated. Copy every quote exactly as written in the text (verbatim, no paraphrase, no ellipses). Express shares as fractions between 0 and 1 (24% -> 0.24) and only when a percentage is written in the quote. 'supplies' edges: the company named in counterparty_name is the CUSTOMER when the filing's company sells to it (w_basis 'revenue' = share of the filing company's revenue), or the SUPPLIER when the filing's company buys from it (w_basis 'purchases' = share of the filing company's purchases). Set direction accordingly: direction 'customer' means the counterparty buys from the filing company; direction 'supplier' means the counterparty sells to the filing company. If a customer is anonymised (for example 'Customer A'), leave counterparty_name empty and put the label in counterparty_anon_label. Each page in the text starts with a line [[PAGE n]]; give the page number the quote came from. Reply with a single JSON object and nothing else.",
  "schema": {
    "type": "object",
    "required": ["edges", "facilities"],
    "properties": {
      "edges": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["rel", "direction", "page", "quote"],
          "properties": {
            "counterparty_name": {"type": ["string", "null"]},
            "counterparty_anon_label": {"type": ["string", "null"]},
            "direction": {"enum": ["customer", "supplier"]},
            "rel": {"enum": ["supplies", "equipment_for", "raw_material_from", "logistics_for"]},
            "w": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
            "w_basis": {"enum": ["revenue", "purchases", null]},
            "period": {"type": ["string", "null"]},
            "component": {"type": ["string", "null"]},
            "page": {"type": "integer", "minimum": 1},
            "quote": {"type": "string", "minLength": 12}
          }
        }
      },
      "facilities": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "kind", "page", "quote"],
          "properties": {
            "name": {"type": "string", "minLength": 2},
            "kind": {"enum": ["plant", "mine", "port", "warehouse", "office"]},
            "address_text": {"type": ["string", "null"]},
            "capacity": {"type": ["object", "null"], "properties": {"value": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]}}},
            "utilisation_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "period": {"type": ["string", "null"]},
            "products": {"type": "array", "items": {"type": "string"}},
            "equipment": {"type": "array", "items": {"type": "object", "required": ["item", "quote"], "properties": {"item": {"type": "string"}, "vendor": {"type": ["string", "null"]}, "quote": {"type": "string"}}}},
            "page": {"type": "integer", "minimum": 1},
            "quote": {"type": "string", "minLength": 12}
          }
        }
      }
    }
  }
}
