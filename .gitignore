# Python
__pycache__/
*.pyc

# Secrets: API keys live in .env locally and in GitHub repository secrets, never in git
.env
.env.*

# Raw price downloads: a cache the daily job rebuilds (new stocks every day would bloat git)
data/raw/

# Built website (GitHub Actions rebuilds and publishes it)
site/

# Screenshots for video editing (kept on this computer only)
video_assets/

# live prices change every 15 minutes; they are fetched fresh on GitHub, not stored
data/screener/live.json

# Private student data: never commit or publish
*.xlsx
*.xls
private/
# terminal data caches (rebuilt from NSE files; persisted by the Actions cache)
data/terminal/
